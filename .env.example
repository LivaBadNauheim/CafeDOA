# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Nur fuer das Punkteprogramm: Der Gast hat keine Sitzung, also schreibt der
# Server fuer ihn - nachdem er die Signatur des Bons geprueft hat.
# NIEMALS mit NEXT_PUBLIC_-Praefix, sonst landet er im Browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Schalter fuer das Punkteprogramm. Solange das nicht auf "true" steht,
# antworten /punkte und /reservierung/punkte mit "nicht gefunden".
PUNKTE_PROGRAMM_AKTIV=false

# E-Mail-Versand ueber Resend (optional).
# Ohne diese Werte funktionieren Reservierungen weiterhin - es gehen dann
# nur keine Mails raus. API-Key unter resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Absender - die Domain muss bei Resend verifiziert sein.
RESERVATION_NOTIFICATION_FROM=Cafe DOA <reservierung@cafe-doa.de>
# Postfach im Cafe. Mehrere Adressen per Komma trennen.
RESERVATION_NOTIFICATION_TO=info@cafe-doa.de
