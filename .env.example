# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# E-Mail-Benachrichtigung bei neuen Reservierungen (optional).
# Ohne diese Werte werden Reservierungen weiterhin gespeichert - es geht
# dann nur keine E-Mail raus. API-Key unter resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Absender - die Domain muss bei Resend verifiziert sein.
RESERVATION_NOTIFICATION_FROM=Reservierung <reservierung@deine-domain.de>
# Empfaenger im Cafe. Mehrere Adressen per Komma trennen.
RESERVATION_NOTIFICATION_TO=info@deine-domain.de
