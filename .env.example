# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# E-Mail-Versand ueber Resend (optional).
# Ohne diese Werte funktionieren Reservierungen weiterhin - es gehen dann
# nur keine Mails raus. API-Key unter resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Absender - die Domain muss bei Resend verifiziert sein.
RESERVATION_NOTIFICATION_FROM=Cafe DOA <reservierung@cafe-doa.de>
# Postfach im Cafe. Mehrere Adressen per Komma trennen.
RESERVATION_NOTIFICATION_TO=info@cafe-doa.de
